# Copy this file to .env (in hw4/, hw4/backend/, or the folder above hw4/) and fill in your own values.
# Never commit the real .env.

# Portkey API key: the backend calls OpenAI's gpt-5.6-luna through the Portkey gateway.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: set to 1 when serving over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=0

# Optional (front end): where the Vite dev server forwards /api and /images.
# BACKEND_URL=http://127.0.0.1:8000
